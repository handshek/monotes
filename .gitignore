# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cursor
.claude
notes.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# browser verification artifacts
/test-results/
/playwright-report/
/.audit/overnight/**/html/
/.audit/overnight/**/test-results/
/.audit/overnight/latest/

# In-place search verification
/.audit/search-dialog/**/html/
/.audit/search-dialog/**/test-results/

# Command search verification
/.audit/command-search/**/html/
/.audit/command-search/**/test-results/

# Collaboration browser verification
/.audit/collab/**/html/
/.audit/collab/**/test-results/
/.audit/collab/latest/
